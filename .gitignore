# ──────────────────────────────────────────────────────────────────
# DocuFlow-CRM — .gitignore
# ──────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
env/

# Environment Variables
.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Database
*.db
*.sqlite3

# Celery
celerybeat-schedule
celerybeat.pid

# Watch Directory Contents (keep the folder, ignore contents)
watch_directory/*
!watch_directory/.gitkeep

# Alembic
alembic/versions/*.pyc

# Logs
*.log
logs/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Coverage
.coverage
htmlcov/
.pytest_cache/
