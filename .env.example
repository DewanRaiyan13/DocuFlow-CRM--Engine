# ──────────────────────────────────────────────────────────────────
# DocuFlow-CRM — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────
APP_NAME=DocuFlow-CRM
DEBUG=true
ENV=development

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://docuflow:docuflow@localhost:5432/docuflow
DB_ECHO=false
DB_POOL_SIZE=20

# ── Redis / Celery ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── File Watcher ───────────────────────────────────────────────────
WATCH_DIRECTORY=./watch_directory

# ── LLM Configuration ─────────────────────────────────────────────
# Supported providers: claude, gemini, openai
LLM_PROVIDER=claude
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Intelligence ───────────────────────────────────────────────────
STALE_LEAD_THRESHOLD_DAYS=14

# ── S3 (Optional) ─────────────────────────────────────────────────
S3_ENABLED=false
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
